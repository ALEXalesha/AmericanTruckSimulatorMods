{
  "package": "alexey_no_rollover",
  "file": "alexey_no_rollover.scs",
  "display_name": "No Rollover (Alexey)",
  "category": "physics",
  "version": "1.0.3",
  "icon": {
    "title": "NO ROLLOVER",
    "subtitle": "НЕ ПЕРЕВОРАЧИВАТЬСЯ",
    "bg": [
      20,
      100,
      110
    ],
    "accent": [
      255,
      230,
      120
    ]
  },
  "patches": {
    "def/vehicle/physics.sii": [
      {
        "key": "sway_bar_stiffness_factor",
        "value": "3.0"
      }
    ],
    "def/vehicle/trailer/*/*.sii": [
      {
        "require": "cog_cargo_mass_max",
        "key": "cog_cargo_offset_min",
        "value": "(0.0, -0.5, 0.0)",
        "or_insert_after_key": "cog_cargo_mass_max",
        "note": "cargo centre of gravity 0.5 m lower: no tipping in a sharp turn with a loaded trailer",
        "per_unit": "accessory_chassis_data"
      },
      {
        "require": "cog_cargo_mass_max",
        "key": "cog_cargo_offset_max",
        "value": "(0.0, -0.5, 0.0)",
        "or_insert_after_key": "cog_cargo_offset_min",
        "note": "cargo centre of gravity 0.5 m lower: no tipping in a sharp turn with a loaded trailer",
        "per_unit": "accessory_chassis_data"
      }
    ]
  }
}
